<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT
     The RecordFS MSI: the program, its runtime DLLs, and the license. WinFsp
     is NOT installed by this MSI — the bundle (SetupRecordFSBundle) chains
     the official signed WinFsp installer first; this package only refuses to
     install where WinFsp is absent (belt for MSI-only installs). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define BinDirV = "$(var.BinDir)" ?>

  <Product Id="*"
           Name="RecordFS"
           Language="1033"
           Version="$(var.RecordFSVersion)"
           Manufacturer="Techtropic Inc."
           UpgradeCode="B26E3474-CD58-4630-AD22-2D4837D99CFE">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="RecordFS — mount business records as a native Windows drive"
             Comments="RecordFS (MIT) — https://github.com/techtropic/recordfs"
             Manufacturer="Techtropic Inc."/>

    <!-- Upgrades install the new version over the old one first and remove the
         old product afterwards. With the default early removal, every upgrade
         would delete the RecordFSUpdate service and create it again, and any
         open handle to it at that instant (services.msc, a monitoring agent)
         leaves it "marked for deletion" until a reboot; an unattended
         update that bricks its own updater. Requires versioned binaries
         (recordfs.exe carries a version resource) and path-stable component
         GUIDs. -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/techtropic/recordfs" />
    <Property Id="ARPCONTACT" Value="Marc Micalizzi" />
    <Property Id="ARPCOMMENTS" Value="RecordFS — records as a native drive (MIT)" />

    <!-- WinFsp must already be present (the bundle guarantees it; a bare MSI
         install fails fast with a clear message instead of a broken mount). -->
    <Property Id="WINFSPINSTALLED">
      <RegistrySearch Id="WinFspRegSearch" Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\WinFsp" Name="InstallDir"
                      Type="raw" Win64="no" />
    </Property>
    <Condition Message="RecordFS requires WinFsp (https://winfsp.dev). Install WinFsp first, or use the RecordFS Setup bundle which installs both.">
      <![CDATA[Installed OR WINFSPINSTALLED]]>
    </Condition>

    <!-- Deployment settings. Both are settable on the command line:
           msiexec /i RecordFS.msi DRIVELETTER=R: VOLUMELABEL="Job Records"
         and through the bundle:
           RecordFSSetup.exe DRIVELETTER=R: VOLUMELABEL="Job Records"
         They are written to HKLM\SOFTWARE\RecordFS as machine policy; the
         agent falls back to S: and "Records" when they are absent, and a
         per-user credential profile, or an explicit drive/volume switch on
         the agent command line, still wins over the machine default. Secure="yes" lets the values survive
         an elevated (UAC) install, where the UI and execute sequences run in
         different processes. -->
    <!-- Settings survive upgrades. An unattended update runs with no command
         line at all, so a plain default here would silently put every site's
         custom drive letter back to S:. Precedence: the command line, then
         what this machine already has, then the default. -->
    <Property Id="DRIVELETTER" Secure="yes" />
    <Property Id="VOLUMELABEL" Secure="yes" />
    <!-- AUTOUPDATE=0 turns automatic updates off (sites that deploy through
         their own tooling); the updater service stays installed but idle. -->
    <Property Id="AUTOUPDATE" Secure="yes" />
    <Property Id="SAVED_DRIVELETTER" Secure="yes">
      <RegistrySearch Id="SavedDriveLetter" Root="HKLM" Key="SOFTWARE\RecordFS"
                      Name="DriveLetter" Type="raw" Win64="yes" />
    </Property>
    <Property Id="SAVED_VOLUMELABEL" Secure="yes">
      <RegistrySearch Id="SavedVolumeLabel" Root="HKLM" Key="SOFTWARE\RecordFS"
                      Name="VolumeLabel" Type="raw" Win64="yes" />
    </Property>
    <Property Id="SAVED_AUTOUPDATE" Secure="yes">
      <RegistrySearch Id="SavedAutoUpdate" Root="HKLM" Key="SOFTWARE\RecordFS"
                      Name="AutoUpdate" Type="raw" Win64="yes" />
    </Property>
    <SetProperty Action="RestoreDriveLetter" Id="DRIVELETTER" Value="[SAVED_DRIVELETTER]"
                 After="AppSearch" Sequence="both">SAVED_DRIVELETTER AND NOT DRIVELETTER</SetProperty>
    <SetProperty Action="DefaultDriveLetter" Id="DRIVELETTER" Value="S:"
                 After="RestoreDriveLetter" Sequence="both">NOT DRIVELETTER</SetProperty>
    <SetProperty Action="RestoreVolumeLabel" Id="VOLUMELABEL" Value="[SAVED_VOLUMELABEL]"
                 After="DefaultDriveLetter" Sequence="both">SAVED_VOLUMELABEL AND NOT VOLUMELABEL</SetProperty>
    <SetProperty Action="DefaultVolumeLabel" Id="VOLUMELABEL" Value="Records"
                 After="RestoreVolumeLabel" Sequence="both">NOT VOLUMELABEL</SetProperty>
    <!-- A DWORD reads back as "#0" / "#1". -->
    <SetProperty Action="RestoreAutoUpdateOff" Id="AUTOUPDATE" Value="0"
                 After="DefaultVolumeLabel" Sequence="both"><![CDATA[SAVED_AUTOUPDATE = "#0" AND NOT AUTOUPDATE]]></SetProperty>
    <SetProperty Action="DefaultAutoUpdate" Id="AUTOUPDATE" Value="1"
                 After="RestoreAutoUpdateOff" Sequence="both">NOT AUTOUPDATE</SetProperty>

    <WixVariable Id="WixUILicenseRtf" Value="..\lic.rtf" />

    <Feature Id="ProductFeature" Title="RecordFS" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentGroupRef Id="PathEntry" />
      <ComponentGroupRef Id="Autostart" />
      <ComponentGroupRef Id="DriveSettings" />
      <ComponentGroupRef Id="UpdaterState" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RecordFS">
          <!-- Created by the updater service itself, with a DACL that only
               SYSTEM and administrators can write through. -->
          <Directory Id="UPDATESFOLDER" Name="updates" />
        </Directory>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="recordfs.exe" Guid="*" Win64="yes">
        <File Id="recordfs.exe" Source="$(var.BinDirV)\recordfs.exe" KeyPath="yes" />
        <!-- Automatic updates from the signed public releases (src/updater.cpp).
             Same binary, service mode. MSI stops it before replacing the file
             and starts it again afterwards; that restarted instance brings
             the users' drives back. -->
        <ServiceInstall Id="RecordFSUpdateService" Name="RecordFSUpdate"
                        DisplayName="RecordFS Updater"
                        Description="Keeps RecordFS up to date from its signed releases. AutoUpdate=0 under HKLM\SOFTWARE\RecordFS turns automatic updates off."
                        Type="ownProcess" Start="auto" Account="LocalSystem"
                        ErrorControl="normal" Arguments="update-service" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="RecordFSUpdateControl" Name="RecordFSUpdate"
                        Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="libssl" Guid="*" Win64="yes">
        <File Id="libssl" Source="$(var.BinDirV)\libssl-3-x64.dll" KeyPath="yes" />
      </Component>
      <Component Id="libcrypto" Guid="*" Win64="yes">
        <File Id="libcrypto" Source="$(var.BinDirV)\libcrypto-3-x64.dll" KeyPath="yes" />
      </Component>
      <Component Id="license" Guid="*" Win64="yes">
        <File Id="license" Source="..\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Machine policy for the drive letter and volume label. Kept in its own
       component so a repair restores it and an uninstall removes it. -->
  <Fragment>
    <ComponentGroup Id="DriveSettings" Directory="INSTALLFOLDER">
      <Component Id="drive_settings" Guid="5C1B7E94-2A38-4D61-9F0C-6E3A81D24B75" Win64="yes" KeyPath="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\RecordFS">
          <RegistryValue Name="DriveLetter" Type="string" Value="[DRIVELETTER]" />
          <RegistryValue Name="VolumeLabel" Type="string" Value="[VOLUMELABEL]" />
          <RegistryValue Name="AutoUpdate" Type="integer" Value="[AUTOUPDATE]" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- The updater's state (HKLM\SOFTWARE\RecordFS\Updater) and its staging
       folder go away with the product. -->
  <Fragment>
    <ComponentGroup Id="UpdaterState" Directory="UPDATESFOLDER">
      <Component Id="updater_state" Guid="4F2B8C61-9D3E-4A57-B1C8-2E6F9A0D7C35" Win64="yes">
        <RegistryValue Root="HKLM" Key="SOFTWARE\RecordFS\Updater" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\RecordFS\Updater" Action="removeOnUninstall" />
        <RemoveFile Id="updates_files" Name="*" On="uninstall" />
        <RemoveFolder Id="updates_folder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Zero-touch autostart: the machine Run key starts `recordfs agent` in
       EVERY user's session at logon (user context — per-user drive letters
       and DPAPI credentials fall out of that). The agent waits quietly until
       that user has logged into the desktop app once (which stores a mount
       token), supervises the mount, and self-restarts on failures. -->
  <Fragment>
    <ComponentGroup Id="Autostart" Directory="INSTALLFOLDER">
      <Component Id="autostart_run" Guid="7E0C4D5B-3F82-4A19-B6D7-9C1E8A25F460" Win64="yes" KeyPath="yes">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="RecordFS" Type="string"
                       Value="&quot;[INSTALLFOLDER]recordfs.exe&quot; agent" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- recordfs on PATH: store-token / probe / mount are how deployments are
       driven until the desktop-integrated flow lands. -->
  <Fragment>
    <ComponentGroup Id="PathEntry" Directory="INSTALLFOLDER">
      <Component Id="path_env" Guid="32FAFA90-9529-496B-B0E9-55E8872DDEAC" Win64="yes" KeyPath="yes">
        <Environment Id="RecordFSPath" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
