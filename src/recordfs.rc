// SPDX-License-Identifier: MIT
// Version resource. MSI replaces a versioned file only with a higher version,
// which is what makes in-place upgrades (and the updater) safe.
#include <winver.h>
#include "version_gen.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RECORDFS_VER_COMMA
 PRODUCTVERSION RECORDFS_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Techtropic Inc."
      VALUE "FileDescription", "RecordFS - business records as a native Windows drive"
      VALUE "FileVersion", RECORDFS_VERSION
      VALUE "InternalName", "recordfs"
      VALUE "LegalCopyright", "Copyright (C) 2026 Marc Micalizzi. MIT License."
      VALUE "OriginalFilename", "recordfs.exe"
      VALUE "ProductName", "RecordFS"
      VALUE "ProductVersion", RECORDFS_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
